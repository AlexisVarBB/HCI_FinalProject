.screen {
    flex-grow: 1;
    padding: 16px;
    background-color: #0A0D12;
}

/* ---------- Header ---------- */

.header {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.back-button {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #262D38;
    background-color: #131821;
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.back-button:hover {
    border-color: #3A4352;
}

.back-button__icon {
    width: 14px;
    height: 14px;
    background-image: url("project://database/Assets/UI/Screens/JoinRoom/Icons/arrow-left.png");
    -unity-background-image-tint-color: #C9CFDA;
}

.header__title {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 18px;
    -unity-font-style: bold;
    color: #F2F4F7;
}

/* ---------- Centro ---------- */

.content {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hash-box {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    border-width: 1px;
    border-color: #2E3646;
    background-color: #1C2230;
    align-items: center;
    justify-content: center;
}

.hash-box__icon {
    width: 18px;
    height: 18px;
    background-image: url("project://database/Assets/UI/Screens/JoinRoom/Icons/hash.png");
    -unity-background-image-tint-color: #00F08A;
}

.hint {
    max-width: 220px;
    margin: 16px 0 0 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: #8A93A3;
}

/* ---------- Cajas del código ---------- */

.code-row {
    flex-direction: row;
    margin-top: 18px;
}

.code-box {
    width: 46px;
    height: 54px;
    margin: 0 5px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #262D38;
    background-color: #131821;
    align-items: center;
    justify-content: center;
    transition-duration: 0.15s;
}

.code-box--active {
    border-color: rgba(0, 240, 138, 0.6);
}

.code-box--filled {
    border-color: #00F08A;
    background-color: #0F1916;
}

.code-row--error .code-box {
    border-color: #FF5C6C;
}

.code-box__char {
    margin: 0;
    padding: 0;
    font-size: 22px;
    -unity-font-style: bold;
    color: #00F08A;
}

/* Campo invisible encima de las cajas: recibe el teclado */
.code-input {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    opacity: 0;
}

.code-input .unity-base-text-field__input {
    flex-grow: 1;
}

/* ---------- Botón y estado ---------- */

.join-button {
    height: 52px;
    margin: 0 0 8px 0;
    border-radius: 14px;
    border-width: 0;
    background-color: #00F08A;
    font-size: 15px;
    -unity-font-style: bold;
    color: #0A0D12;
    transition-duration: 0.15s;
}

.join-button:hover {
    background-color: #2BFFA2;
}

.join-button:active {
    background-color: #00C873;
    scale: 0.98 0.98;
}

.join-button:disabled {
    opacity: 0.4;
}

.status-label {
    display: none;
    margin: 0 0 10px 0;
    font-size: 12px;
    -unity-text-align: middle-center;
    color: #8A93A3;
}

.status-label--visible {
    display: flex;
}

.status-label--error {
    color: #FF5C6C;
}

.status-label--success {
    color: #00F08A;
}
