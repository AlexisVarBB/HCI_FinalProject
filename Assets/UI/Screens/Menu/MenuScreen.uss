.screen {
    flex-grow: 1;
    padding: 16px;
    background-color: rgb(10, 13, 18);
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.brand {
    flex-direction: row;
    align-items: center;
}

.brand-logo {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(0, 240, 138, 0.35);
    background-color: rgb(14, 24, 20);
    align-items: center;
    justify-content: center;
}

.brand-logo__icon {
    width: 14px;
    height: 14px;
}

.brand-title {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(242, 244, 247);
}

.brand-title--accent {
    color: rgb(0, 240, 138);
}

.user-pill {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding: 0 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(38, 45, 56);
    background-color: rgb(19, 24, 33);
    transition-duration: 0.15s;
}

.user-pill:hover {
    border-color: rgb(58, 67, 82);
}

.user-pill__icon {
    width: 11px;
    height: 11px;
    margin-right: 6px;
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/logout.png?fileID=-5975938820719141926&guid=2efb62d8d8536b04c93cb4c6e95a0ae0&type=3#logout_0");
    -unity-background-image-tint-color: rgb(138, 147, 163);
}

.user-pill__label {
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgb(138, 147, 163);
}

.greeting {
    margin: 22px 0 0 0;
    padding: 0;
    font-size: 31px;
    -unity-font-style: bold;
    color: rgb(242, 244, 247);
    white-space: normal;
}

.cards {
    flex-grow: 1;
    justify-content: center;
}

.card {
    min-height: 172px;
    margin-bottom: 10px;
    padding: 16px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(38, 45, 56);
    background-color: rgb(19, 24, 33);
    overflow: hidden;
    transition-duration: 0.15s;
}

.card:hover {
    border-color: rgb(58, 67, 82);
}

.card:active {
    scale: 0.98 0.98;
}

.card--primary {
    border-color: rgba(0, 240, 138, 0.45);
    background-color: rgb(15, 25, 22);
}

.card--primary:hover {
    border-color: rgb(0, 240, 138);
}

.card__glow {
    position: absolute;
    top: -110px;
    right: -60px;
    width: 260px;
    height: 260px;
}

.card__top {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    flex-grow: 1;
}

.card__icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(46, 54, 70);
    background-color: rgb(28, 34, 48);
    align-items: center;
    justify-content: center;
}

.card--primary .card__icon-box {
    border-width: 0;
    background-color: rgb(0, 240, 138);
}

.card__icon {
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: rgb(201, 207, 218);
}

.card--primary .card__icon {
    -unity-background-image-tint-color: rgb(10, 13, 18);
}

.card__icon--crown {
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/crown.png?fileID=-8222406987496834216&guid=95183e1858df9b44ba9433e02c5d341b&type=3#crown_0");
}

.card__icon--users {
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/users.png?fileID=5161897967501941137&guid=f30bc712b5483274eb6dc814bc985844&type=3#users_0");
}

.card__arrow {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(46, 54, 70);
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
    justify-content: center;
}

.card__arrow-icon {
    width: 11px;
    height: 11px;
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/arrow-up-right.png?fileID=-2419498710101293994&guid=ffc2ea4c72de99145bf76a19d45bc74e&type=3#arrow-up-right_0");
    -unity-background-image-tint-color: rgb(138, 147, 163);
}

.card--primary .card__arrow-icon {
    -unity-background-image-tint-color: rgb(0, 240, 138);
}

.card__eyebrow {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 9px;
    letter-spacing: 1px;
    color: rgb(138, 147, 163);
}

.card--primary .card__eyebrow {
    color: rgb(0, 240, 138);
}

.card__title {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(242, 244, 247);
}

.protect-link {
}
