.screen {
    flex-grow: 1;
    padding: 16px;
    background-color: #0A0D12;
}

/* ---------- Header ---------- */

.header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.brand {
    flex-direction: row;
    align-items: center;
}

.brand-logo {
    width: 26px;
    height: 26px;
    margin-right: 8px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(0, 240, 138, 0.35);
    background-color: #0E1814;
    align-items: center;
    justify-content: center;
}

.brand-logo__icon {
    width: 14px;
    height: 14px;
}

.brand-title {
    margin: 0;
    padding: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: #F2F4F7;
}

.brand-title--accent {
    color: #00F08A;
}

.user-pill {
    flex-direction: row;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #262D38;
    background-color: #131821;
    transition-duration: 0.15s;
}

.user-pill:hover {
    border-color: #3A4352;
}

.user-pill__icon {
    width: 11px;
    height: 11px;
    margin-right: 6px;
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/logout.png");
    -unity-background-image-tint-color: #8A93A3;
}

.user-pill__label {
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: #8A93A3;
}

/* ---------- Saludo ---------- */

.greeting {
    margin: 22px 0 0 0;
    padding: 0;
    font-size: 21px;
    -unity-font-style: bold;
    color: #F2F4F7;
    white-space: normal;
}

/* ---------- Tarjetas ---------- */

.cards {
    flex-grow: 1;
    justify-content: center;
}

.card {
    min-height: 172px;
    margin-bottom: 10px;
    padding: 16px;
    border-radius: 16px;
    border-width: 1px;
    border-color: #262D38;
    background-color: #131821;
    overflow: hidden;
    transition-duration: 0.15s;
}

.card:hover {
    border-color: #3A4352;
}

.card:active {
    scale: 0.98 0.98;
}

.card--primary {
    border-color: rgba(0, 240, 138, 0.45);
    background-color: #0F1916;
}

.card--primary:hover {
    border-color: #00F08A;
}

.card__glow {
    position: absolute;
    top: -110px;
    right: -60px;
    width: 260px;
    height: 260px;
}

.card__top {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    flex-grow: 1;
}

.card__icon-box {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #2E3646;
    background-color: #1C2230;
    align-items: center;
    justify-content: center;
}

.card--primary .card__icon-box {
    border-width: 0;
    background-color: #00F08A;
}

.card__icon {
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: #C9CFDA;
}

.card--primary .card__icon {
    -unity-background-image-tint-color: #0A0D12;
}

.card__icon--crown {
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/crown.png");
}

.card__icon--users {
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/users.png");
}

.card__arrow {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2E3646;
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
    justify-content: center;
}

.card__arrow-icon {
    width: 11px;
    height: 11px;
    background-image: url("project://database/Assets/UI/Screens/Menu/Icons/arrow-up-right.png");
    -unity-background-image-tint-color: #8A93A3;
}

.card--primary .card__arrow-icon {
    -unity-background-image-tint-color: #00F08A;
}

.card__eyebrow {
    margin: 0 0 4px 0;
    padding: 0;
    font-size: 9px;
    letter-spacing: 1px;
    color: #8A93A3;
}

.card--primary .card__eyebrow {
    color: #00F08A;
}

.card__title {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: #F2F4F7;
}
