<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:dt="DetoxBet.UI" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Screens/Menu/MenuScreen.uss?fileID=7433441132597879392&amp;guid=3131ce0ada93f4b4a966e1b2084d2599&amp;type=3#MenuScreen"/>
    <ui:VisualElement name="menuScreen" class="screen">
        <ui:VisualElement name="header" class="header">
            <ui:VisualElement class="brand">
                <ui:VisualElement class="brand-logo">
                    <dt:ShieldBoltIcon class="brand-logo__icon"/>
                </ui:VisualElement>
                <ui:Label text="Detox" class="brand-title"/>
                <ui:Label text="Bet" class="brand-title brand-title--accent"/>
            </ui:VisualElement>
            <ui:VisualElement name="logoutButton" class="user-pill">
                <ui:VisualElement picking-mode="Ignore" class="user-pill__icon"/>
                <ui:Label name="userNameLabel" text="Alexis" picking-mode="Ignore" class="user-pill__label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="greetingLabel" text="Hello, &lt;color=#00F08A&gt;Alexis&lt;/color&gt;! Ready to focus?" class="greeting"/>
        <ui:Label name="protectLink" text="Protect your account · create a password" class="protect-link"/>
        <ui:VisualElement name="cards" class="cards">
            <ui:VisualElement name="createRoomCard" class="card card--primary">
                <dt:RadialGlow picking-mode="Ignore" class="card__glow"/>
                <ui:VisualElement picking-mode="Ignore" class="card__top">
                    <ui:VisualElement picking-mode="Ignore" class="card__icon-box">
                        <ui:VisualElement picking-mode="Ignore" class="card__icon card__icon--crown"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="card__arrow">
                        <ui:VisualElement picking-mode="Ignore" class="card__arrow-icon"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="HOST A CHALLENGE" picking-mode="Ignore" class="card__eyebrow"/>
                <ui:Label text="Create a Room" picking-mode="Ignore" class="card__title"/>
            </ui:VisualElement>
            <ui:VisualElement name="joinRoomCard" class="card">
                <ui:VisualElement picking-mode="Ignore" class="card__top">
                    <ui:VisualElement picking-mode="Ignore" class="card__icon-box">
                        <ui:VisualElement picking-mode="Ignore" class="card__icon card__icon--users"/>
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="card__arrow">
                        <ui:VisualElement picking-mode="Ignore" class="card__arrow-icon"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="ENTER INVITE CODE" picking-mode="Ignore" class="card__eyebrow"/>
                <ui:Label text="Join a Room" picking-mode="Ignore" class="card__title"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
